{
    "version": "1.0.0",
    "description": "The cover musician's studio: local AI stem separation to practise, rehearse and record covers.",
    "homepage": "https://github.com/asanzhuerta/Cover_Maker",
    "license": "MIT",
    "notes": [
        "On first start Cover_Maker downloads its separation runtime (Python, PyTorch, ffmpeg) into",
        "%LOCALAPPDATA%\\Cover_Maker, and AI models only after you accept their licences.",
        "Update it with 'scoop update cover-maker' and skip the in-app update prompt,",
        "which would install a second, per-user copy."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/asanzhuerta/Cover_Maker/releases/download/v1.0.0/Cover_Maker_1.0.0_x64-setup.exe#/dl.7z"
        }
    },
    "pre_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$TEMP\", \"$dir\\uninstall.exe\", \"$dir\\[NSIS].nsi\" -Recurse -Force -ErrorAction SilentlyContinue",
    "shortcuts": [
        [
            "Cover_Maker.exe",
            "Cover_Maker"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/asanzhuerta/Cover_Maker/releases/download/v$version/Cover_Maker_$version_x64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
