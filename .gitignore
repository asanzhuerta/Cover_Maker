# Audio and model files never belong in the repository
*.wav
*.flac
*.mp3
*.m4a
*.ogg
*.opus
*.aac
*.ckpt
*.pth
*.onnx
# Basic Pitch note-transcription model (Apache-2.0, 230 KB), bundled on purpose (ADR-012).
!engine/src/cover_maker/data/basic_pitch/nmp.onnx
*.safetensors
# ...except the short Creative Commons example song offered on first run
# (CC0 or CC BY, under 30 s and 2 MB; credited in THIRD_PARTY_NOTICES.md).
!engine/src/cover_maker/data/example/*.mp3

# OS / editors
Thumbs.db
.DS_Store
.idea/

# latexmk-generated version stamp
docs/latex/*/version.tex
.claude/launch.json
