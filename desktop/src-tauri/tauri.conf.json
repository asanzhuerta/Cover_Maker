{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cover_Maker",
  "version": "0.4.0",
  "identifier": "io.github.asanzhuerta.covermaker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Cover_Maker",
        "width": 1200,
        "minWidth": 900,
        "height": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Cover_Maker, the cover musician's studio",
    "longDescription": "Cover_Maker, the cover musician's studio: local AI stem separation for practising and recording covers.",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/runtime/": "bundle/"
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "English",
          "Spanish",
          "PortugueseBR",
          "French",
          "German",
          "Italian"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NDJFQkM4OTVCNUUxQTUKUldTbDRiV1Z5T3RDR2ROR3RhdVpMY2Y1MUNuSktIejVWYkVTM21qUnBHZDBxdWVweFNaZTZOWmcK",
      "endpoints": [
        "https://github.com/asanzhuerta/Cover_Maker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
